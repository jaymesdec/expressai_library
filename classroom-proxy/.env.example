# ---- Classroom AI Proxy configuration ----

# Your REAL OpenAI API key. Held only on the server; students never see it.
OPENAI_API_KEY=sk-your-real-openai-key

# The shared classroom password students type into their notebooks.
# Change this to something only your class knows.
CLASSROOM_SECRET=change-me-to-a-class-password

# Cost controls (optional — sensible defaults shown)
ALLOWED_MODEL=gpt-4o-mini      # every request is forced to this model
MAX_TOKENS_CAP=400             # max_tokens is capped to this ceiling

# Rate limiting (optional)
RATE_LIMIT_MAX=15              # max requests...
RATE_LIMIT_WINDOW=60           # ...per this many seconds, per student/IP
